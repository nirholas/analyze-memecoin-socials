# Environment variables
.env

# Data files (generated by scripts, can be large)
# Note: /data/ is the scripts data folder, NOT web/public/data/
# Unignored: data/pump-sdk/ is tracked for the case study
/data/*
!/data/pump-sdk/
# The scraped post corpora are inputs to the analysis, not generated output
!/data/tweets/
# The candle archive outlives GeckoTerminal's 180-day public window
!/data/ohlcv/
*.duckdb
*.duckdb-wal
*.duckdb-shm
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Output
*.html
!chart/*.html
# Generated per-asset charts are the deliverable: they open with no server
!out/**/*.html
# GitHub Pages root: a copy of out/three/chart.html
!/index.html
reports/

# wrangler's local deploy state
/.wrangler/

# Backup archives
*_backup_*.zip

# Research/analysis work (not part of main app)
/analysis/

.vercel

# Allow chart visualization and research data
!web/chart.html
!/data/pump-sdk-*.json
!/data/pump-sdk-*.csv
.cache/
node_modules/

# assembled by scripts/build-site.mjs
_site/

# wrangler deploy state
.wrangler/
